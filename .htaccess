Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Public assets, including Laravel's public storage link.
    RewriteRule ^(assets|build|css|js|storage)/(.*)$ public/$1/$2 [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]

    # Keep application code and development files outside direct web access.
    RewriteRule ^(?:app|bootstrap|config|database|resources|storage|vendor|preview|docs|integration|tests|node_modules|test-results|tools)(?:/|$) - [F,L]
    RewriteRule ^(?:\.|README|AGENTS|composer|package|artisan|phpunit|playwright) - [F,L,NC]

    # The root entry point delegates dynamic requests to Laravel.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
